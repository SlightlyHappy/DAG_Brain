# Copy to .env (mode 600). Never commit the real file.

# One shared passphrase for everyone you invite. Generate one:  openssl rand -base64 18
DAGBRAIN_PASSWORD=

# Signs session cookies. Generate one:  openssl rand -hex 32
DAGBRAIN_SECRET=

# Optional: a model for the assistant. Without one, the rule-based assistant answers
# and every calculation still works. Use a key with a spending limit.
# DEFAULT_LLM_PROVIDER=openrouter
# DEFAULT_LLM_MODEL=google/gemini-2.5-flash
# OPENROUTER_API_KEY=

# Contact email for OpenAlex and Unpaywall (faster, more reliable literature lookups)
# SCHOLARLY_CONTACT_EMAIL=

# Block every outbound request (no literature search, no cloud models):
# OFFLINE_MODE=true
