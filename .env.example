# ============================================================================
# DAG_Brain (Causal Studio) Configuration
# Copy this file to .env or configure providers live inside the UI Settings!
# ============================================================================

# Server Settings
HOST=127.0.0.1
PORT=8000
DATABASE_PATH=./data/dag_brain.sqlite

# Default Active Provider: openrouter | ollama | gemini | openai | anthropic | custom
DEFAULT_LLM_PROVIDER=openrouter
DEFAULT_LLM_MODEL=google/gemini-2.5-flash

# 1. OpenRouter (Recommended for unified access to Claude, Gemini, DeepSeek, GPT, Llama)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# 2. Ollama (100% Free, Local, Private / Air-Gapped Self-Hosting)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2

# 3. Google Gemini (Direct API)
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-2.5-flash

# 4. OpenAI (Direct API)
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4o-mini

# 5. Anthropic Claude (Direct API)
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-3-7-sonnet-latest

# 6. Custom OpenAI-Compatible Endpoint (LM Studio, vLLM, Institutional Proxy)
CUSTOM_OPENAI_BASE_URL=http://localhost:1234/v1
CUSTOM_OPENAI_API_KEY=lm-studio
CUSTOM_OPENAI_MODEL=local-model

# ============================================================================
# INTERNET SEARCH & SCHOLARLY FULL-TEXT INTEGRATIONS
# ============================================================================

# Tavily AI Search API (Enables autonomous internet research for the AI Agent)
TAVILY_API_KEY=

# CORE.ac.uk API v3 (300M+ Open Access Research Papers & Full Texts)
CORE_API_KEY=

# SerpApi Key (Optional: for automated Google Scholar API scraping; direct links work without key)
SERPAPI_API_KEY=

# Semantic Scholar API Key (Optional: increases rate limits)
SEMANTIC_SCHOLAR_API_KEY=

# SearXNG Instance URL (Optional: self-hosted metasearch engine for Web + Google Scholar)
SEARXNG_BASE_URL=

# Institutional proxy prefix for full text you are licensed to read, e.g. https://ezproxy.your-university.edu/login?url=
EZPROXY_PREFIX=

# Local-only mode: block every outbound request except to this machine (e.g. Ollama)
OFFLINE_MODE=false

# Literature Search Polite Pool Email (Improves OpenAlex, Crossref & Unpaywall rate limits)
SCHOLARLY_CONTACT_EMAIL=researcher@example.org
